{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pika-go.local/schemas/knowledge-record-v1.schema.json",
  "title": "Pika Knowledge Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "knowledge_id", "kind", "status", "scope", "summary", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "knowledge_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["observation", "bottleneck", "hypothesis", "experiment-result", "integration-verdict"]},
    "status": {"enum": ["provisional", "observed-negative", "inconclusive", "verified", "integration-rejected"]},
    "scope": {"$ref": "#/$defs/scope"},
    "summary": {"type": "string", "minLength": 1},
    "hypothesis_mechanism": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "evidence_artifact_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "experiment": {"$ref": "#/$defs/experimentEvidence"}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids", "best_sha", "baseline_revision_id", "hardware", "software"],
      "properties": {
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "best_sha": {"type": "string", "minLength": 1},
        "baseline_revision_id": {"type": "string", "minLength": 1},
        "hardware": {"$ref": "#/$defs/environmentProfile"},
        "software": {"$ref": "#/$defs/environmentProfile"}
      }
    },
    "environmentProfile": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "diagnosis_id": {"type": "string", "minLength": 1},
        "experiment_id": {"type": "string", "minLength": 1},
        "integration_id": {"type": "string", "minLength": 1}
      }
    },
    "experimentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derived_comparisons": {
          "type": "array",
          "items": {"$ref": "#/$defs/comparison"}
        },
        "artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_id", "metric_id", "speedup", "regression", "regression_fraction"],
      "properties": {
        "integration_id": {"type": "string"},
        "experiment_id": {"type": "string", "minLength": 1},
        "receipt_id": {"type": "string", "minLength": 1},
        "scope_best_sha": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "reference_value": {"type": "number"},
        "candidate_value": {"type": "number"},
        "speedup": {"type": "number", "minimum": 0},
        "regression": {"type": "boolean"},
        "regression_fraction": {"type": "number", "minimum": 0},
        "aggregate_speedup": {"type": "number", "exclusiveMinimum": 0},
        "max_case_speedup": {"type": "number", "exclusiveMinimum": 0},
        "max_case_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
