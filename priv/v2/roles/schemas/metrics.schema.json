{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pika://v2/metrics.schema.json",
  "title": "Pika v2 Metrics",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "direction": {"enum": ["minimize", "maximize"]},
          "role": {"enum": ["primary", "guard", "informational"]}
        },
        "required": ["id", "unit", "direction", "role"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "metrics"],
  "additionalProperties": false
}
